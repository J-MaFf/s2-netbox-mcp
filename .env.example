# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. Nothing in this repo logs NETBOX_PASSWORD anywhere.

# Base URL of the S2 NetBox controller's web interface, no trailing slash and
# no path (the client appends the NBAPI path itself — see NETBOX_API_PATH
# below). Example:
#   NETBOX_BASE_URL=https://netbox.example.internal
NETBOX_BASE_URL=

# NBAPI session-login credentials for a NetBox operator account with API access enabled.
NETBOX_USERNAME=
NETBOX_PASSWORD=

# Optional. The NBAPI path appended to NETBOX_BASE_URL. Defaults to
# /nbws/goforms/nbapi, which is the verified path on NetBox 6.x controllers.
# Only set this to override the default — e.g. to the legacy, pre-6.x path
# /goforms/nbapi, which returns HTTP 410 Gone on 6.x controllers.
NETBOX_API_PATH=

# Optional. Defaults to unset/false (TLS certificates are verified normally).
# Set to "true" ONLY to accept a self-signed/on-prem certificate on a
# controller you trust. This is an explicit opt-in, never a silent fallback.
NETBOX_ALLOW_INSECURE_TLS=

# Optional. Defaults to unset/false. Set to "true"/"1"/"yes" to register the
# write tools (add/modify/delete/lock/unlock/activate/trigger/etc). Left
# unset, this server stays strictly read-only. See README.md "Write access".
NETBOX_ENABLE_WRITES=

# Optional. Defaults to unset/false. Set to "true"/"1"/"yes" TOGETHER WITH
# NETBOX_ENABLE_WRITES to additionally register the 11 destructive tools
# (deletes/removes). Requires NETBOX_ENABLE_WRITES to also be truthy.
NETBOX_ENABLE_DESTRUCTIVE=

# Optional. Request path used only for the trigger_event tool. Unset/empty
# tracks whatever NETBOX_API_PATH resolves to. Only set this if your
# controller serves the Event API at a separate path, e.g. the pre-6.x
# documented value /appd/nbapi.
NETBOX_EVENT_API_PATH=

# Optional. Reserved for the managed unlock-window feature (not yet
# implemented in this build). Defaults to "8,7,6" — 1-3 distinct integers in
# 1..8, comma-separated.
NETBOX_UNLOCK_HOLIDAY_GROUPS=

# Optional. Reserved for the managed unlock-window feature (not yet
# implemented in this build). Defaults to "MCP Unlock Window" — 1-40 characters.
NETBOX_UNLOCK_NAME_PREFIX=

# Optional. Reserved for the (not yet implemented) live write smoke test
# (npm run test:live:write) — the PORTALKEY of a door you designate safe to
# physically unlock during that opt-in test. Read only by that script, never
# by the server itself.
NETBOX_LIVE_TEST_PORTALKEY=
