# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. Nothing in this repo logs NETBOX_PASSWORD anywhere.

# Base URL of the S2 NetBox controller's web interface, no trailing slash and
# no path (the client appends /goforms/nbapi itself). Example:
#   NETBOX_BASE_URL=https://netbox.example.internal
NETBOX_BASE_URL=

# NBAPI session-login credentials for a NetBox operator account with API access enabled.
NETBOX_USERNAME=
NETBOX_PASSWORD=

# Optional. Defaults to unset/false (TLS certificates are verified normally).
# Set to "true" ONLY to accept a self-signed/on-prem certificate on a
# controller you trust. This is an explicit opt-in, never a silent fallback.
NETBOX_ALLOW_INSECURE_TLS=
